{
  "name": "ScheduledJob",
  "type": "object",
  "properties": {
    "job_type": {
      "type": "string",
      "enum": [
        "generate_series",
        "generate_episode",
        "publish_episode"
      ],
      "default": "generate_episode"
    },
    "series_id": {
      "type": "string"
    },
    "episode_id": {
      "type": "string",
      "description": "Required for publish_episode jobs"
    },
    "platform": {
      "type": "string",
      "enum": [
        "tiktok",
        "youtube_shorts",
        "reels",
        "stories"
      ],
      "default": "tiktok"
    },
    "scheduled_time": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "cancelled"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "job_type",
    "series_id",
    "scheduled_time"
  ]
}