# Backend Environment Variables
# Copy this file to .env and fill in the actual values
# DO NOT commit .env to version control (already in .gitignore)

# CockroachDB
# Format: postgresql://user:password@host:26257/defaultdb?sslmode=verify-full
COCKROACHDB_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full

# Redis
# Format: redis://default:password@host:port
REDIS_URL=redis://default:password@host:10965

# DashScope (Alibaba AI services)
# Get from: https://dashscope-intl.aliyuncs.com/
DASHSCOPE_API_KEY=sk-ws-xxx

# Backblaze B2 Storage
# Get from: https://www.backblaze.com/b2/cloud-storage.html
B2_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key
B2_BUCKET_NAME=your-bucket-name
B2_ENDPOINT_URL=s3.us-east-005.backblazeb2.com
B2_READ_KEY_ID=your-read-key-id
B2_READ_APPLICATION_KEY=your-read-application-key
