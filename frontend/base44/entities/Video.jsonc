{
  "name": "Video",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "string",
      "description": "The text prompt used to generate the video",
      "title": "Prompt"
    },
    "category": {
      "type": "string",
      "enum": [
        "cinematic",
        "portrait",
        "product",
        "landscape",
        "abstract",
        "fashion",
        "travel"
      ],
      "default": "cinematic",
      "title": "Category"
    },
    "status": {
      "type": "string",
      "enum": [
        "generating",
        "ready",
        "failed"
      ],
      "default": "generating",
      "title": "Status"
    },
    "aspect_ratio": {
      "type": "string",
      "enum": [
        "16:9",
        "9:16",
        "1:1"
      ],
      "default": "16:9",
      "title": "Aspect Ratio"
    },
    "resolution": {
      "type": "string",
      "enum": [
        "720p",
        "1080p",
        "4K"
      ],
      "default": "1080p",
      "title": "Resolution"
    },
    "duration": {
      "type": "integer",
      "enum": [
        4,
        6,
        8
      ],
      "default": 6,
      "title": "Duration (seconds)"
    },
    "motion_style": {
      "type": "string",
      "enum": [
        "smooth",
        "dynamic",
        "slow",
        "fast",
        "cinematic"
      ],
      "default": "cinematic",
      "title": "Motion Style"
    },
    "camera_mode": {
      "type": "string",
      "enum": [
        "static",
        "dolly",
        "orbit",
        "crane",
        "handheld"
      ],
      "default": "dolly",
      "title": "Camera Mode"
    },
    "video_url": {
      "type": "string",
      "description": "URL to the rendered video file",
      "title": "Video URL"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "URL to the video thumbnail image",
      "title": "Thumbnail URL"
    },
    "likes": {
      "type": "integer",
      "default": 0,
      "title": "Likes"
    },
    "is_liked": {
      "type": "boolean",
      "default": false,
      "title": "Liked by current user"
    }
  },
  "required": [
    "prompt"
  ]
}